# Скопируй в /home/<VPS_USER>/discordchatbot.env на VPS (не в репозиторий!) и заполни реальными значениями.
# Путь в этом файле должен совпадать с EnvironmentFile= в discordchatbot.service.

Discord__Token=твой_discord_bot_token
OpenAI__ApiKey=твой_openai_api_key
OpenAI__Model=gpt-5.4

# Абсолютный путь вне publish-директории, чтобы файл с памятью не терялся при каждом dotnet publish
RelationshipsFile=/home/<VPS_USER>/discordchatbot-data/relationships.json
