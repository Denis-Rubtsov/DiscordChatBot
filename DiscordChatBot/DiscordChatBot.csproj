<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- OpenAI.Realtime (voice chat) is marked experimental by the SDK; we use it deliberately. -->
        <NoWarn>$(NoWarn);OPENAI002</NoWarn>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Discord.Net.WebSocket" Version="3.20.1" />
      <PackageReference Include="OpenAI" Version="2.12.0" />
    </ItemGroup>

</Project>
